// นำ test และ expect มาจาก Playwright Test
// test ใช้สร้าง Test Case ส่วน expect ใช้ตรวจสอบผลลัพธ์
const { test, expect } = require('@playwright/test');

// จัดกลุ่ม Test Case ที่เกี่ยวข้องกับ Login
test.describe('Login Test', () => {

    // ทำงานก่อนเริ่ม Test Case ทุกกรณี
    test.beforeEach(async ({ page }) => {

        // เปิดเว็บไซต์ SauceDemo
        await page.goto('https://www.saucedemo.com/');

    });

    // TC01: Login สำเร็จ
    test('TC01 - Login successfully', async ({ page }) => {

        // ค้นหาช่อง Username แล้วกรอกข้อมูล
        await page.locator('#user-name').fill('standard_user');

        // ค้นหาช่อง Password แล้วกรอกข้อมูล
        await page.locator('#password').fill('secret_sauce');

        // คลิกปุ่ม Login
        await page.locator('#login-button').click();

        // ตรวจสอบว่า URL มี inventory.html
        await expect(page).toHaveURL(/inventory\.html/);

        // ตรวจสอบว่าหัวข้อ Products ปรากฏบนหน้าเว็บ
        await expect(page.locator('.title')).toHaveText('Products');

    });

    // TC02: Login โดยไม่กรอก Username
    test('TC02 - Empty username', async ({ page }) => {

        // กรอกเฉพาะ Password
        await page.locator('#password').fill('secret_sauce');

        // คลิกปุ่ม Login
        await page.locator('#login-button').click();

        // ตรวจสอบข้อความแจ้งเตือน Username is required
        await expect(page.locator('[data-test="error"]'))
            .toContainText('Username is required');

    });

    // TC03: Login โดยกรอก Password ผิด
    test('TC03 - Invalid password', async ({ page }) => {

        // กรอก Username ที่ถูกต้อง
        await page.locator('#user-name').fill('standard_user');

        // กรอก Password ที่ไม่ถูกต้อง
        await page.locator('#password').fill('wrong_password');

        // คลิกปุ่ม Login
        await page.locator('#login-button').click();

        // ตรวจสอบว่ามีข้อความแจ้งเตือน
        await expect(page.locator('[data-test="error"]')).toBeVisible();

    });

    // TC04: Login โดยไม่กรอกข้อมูลทั้งสองช่อง
    test('TC04 - Empty username and password', async ({ page }) => {

        // ไม่กรอก Username และ Password
        // คลิกปุ่ม Login ทันที
        await page.locator('#login-button').click();

        // ตรวจสอบว่าระบบแจ้งให้กรอก Username
        await expect(page.locator('[data-test="error"]'))
            .toContainText('Username is required');

    });

});





